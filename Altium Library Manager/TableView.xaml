<UserControl x:Class="Altium_Library_Manager.TableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Toolbar buttons don't take the focus, so the grid keeps its selected row and the cell being edited -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The commands stay in their places: unavailable ones are dimmed, never hidden, so nothing jumps. Dimmed
             rather than disabled: a disabled Fluent button paints a light box, which stands out in the dark theme. -->
        <Style x:Key="RowCommand" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SaveCommand" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirty}" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The Edit switch -->
        <Style x:Key="EditSwitch" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="12,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="Edit" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Margin="0,0,8,0" />
                            <Grid Width="36" Height="18" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="9" BorderThickness="1" Background="Transparent"
                                        BorderBrush="{DynamicResource MutedTextBrush}" />
                                <Ellipse x:Name="Knob" Width="10" Height="10" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="{DynamicResource MutedTextBrush}" />
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ContentBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Search on the left; editing on the right -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="6,5,6,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- The commands on the right always keep their width; the count gives way first in a narrow panel -->
                    <ColumnDefinition Width="3*" MinWidth="120" MaxWidth="340" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Padding="2" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                             AutomationProperties.Name="Search rows"
                             ToolTip="Finds rows with every word you type, in any order (&quot;10k 0603&quot;); quotes keep words together. Up / Down pick a row, Enter goes to it, Esc clears." />
                    <TextBlock Text="Search rows (Ctrl+F)" Foreground="{DynamicResource MutedTextBrush}" Margin="5,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Which columns the search looks in -->
                <Button x:Name="ColumnsButton" Grid.Column="1" Style="{StaticResource ToolButton}" Click="ColumnsButton_Click"
                        ToolTip="Columns to search in (remembered for this table)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="In:" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{Binding SearchColumnsText}" Margin="4,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource ToolIcon}" FontSize="10" Text="&#xE70D;" Margin="8,1,0,0" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="2" Text="{Binding CountText}" ToolTip="{Binding CountText}" Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <!-- Row commands: active while the Edit switch is on -->
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RowCommand}" Click="AddRow_Click" ToolTip="Add a row at the end (Ctrl+Plus)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE710;" />
                                <TextBlock Text="Add row" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RowCommand}" Click="AddElements_Click"
                                ToolTip="Add many similar components at once, differing in their value: resistors of a series, a list of capacitors, …">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8FD;" />
                                <TextBlock Text="Add elements…" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RowCommand}" Click="Duplicate_Click"
                                ToolTip="Add a copy of the selected row, to make a similar part (Ctrl+D)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8C8;" />
                                <TextBlock Text="Duplicate" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RowCommand}" Click="Delete_Click" ToolTip="Delete the rows of the selected cells (Ctrl+Minus); Ctrl+Z brings them back">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74D;" />
                                <TextBlock Text="Delete" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="18" Margin="10,0,4,0" Background="{DynamicResource PanelBorderBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Active while the table has unsaved changes (the star in the tab's title) -->
                    <Button Style="{StaticResource SaveCommand}" Click="Save_Click" ToolTip="Write the changes to the database (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74E;" />
                            <TextBlock Text="Save" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Reload_Click" ToolTip="Read the table from the database again (F5)">
                        <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE72C;" />
                    </Button>
                    <!-- Tables open read-only; editing is switched on per table -->
                    <ToggleButton x:Name="EditToggle" Style="{StaticResource EditSwitch}"
                                  IsChecked="{Binding IsEditing}" IsEnabled="{Binding CanEdit}"
                                  AutomationProperties.Name="Edit"
                                  ToolTip="Edit the rows of this table (Ctrl+E). Changes stay in the table, marked with a star, until you save it (Ctrl+S); Ctrl+Z / Ctrl+Y undo and redo them." />
                </StackPanel>
            </Grid>
        </Border>

        <ContentPresenter x:Name="GridHost" />
    </DockPanel>
</UserControl>
