<UserControl x:Class="Altium_Library_Manager.FieldsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Altium_Library_Manager"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Compact text box (Fluent's is a 32 px touch target with a clear button that covers short values such as
             the size): Fluent colors, accent underline while typing -->
        <Style x:Key="CellText" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="0,0,3,3"
                                    Background="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CellCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CellCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <!-- Toolbar buttons don't take the focus, so the row being edited stays selected while they act on it -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Add / remove / reorder -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Click="Add_Click" ToolTip="Add an empty field after the selected one (Ctrl+Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Text="Add field" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <!-- The usual Altium fields, one click each; the ones already in the list are greyed out -->
                <Button x:Name="StandardButton" Style="{StaticResource ToolButton}" Click="Standard_Click"
                        ToolTip="Add a standard Altium field">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Standard fields" />
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" VerticalAlignment="Center" FontSize="10" Margin="8,1,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="RemoveButton" Style="{StaticResource ToolButton}" Click="Remove_Click" ToolTip="Remove the selected field">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Text="Remove" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="UpButton" Style="{StaticResource ToolButton}" Click="Up_Click"
                        ToolTip="Move the selected field up (Alt+Up), or drag it by the handle on the left"
                        FontFamily="{StaticResource IconFont}" Content="&#xE74A;" />
                <Button x:Name="DownButton" Style="{StaticResource ToolButton}" Click="Down_Click"
                        ToolTip="Move the selected field down (Alt+Down), or drag it by the handle on the left"
                        FontFamily="{StaticResource IconFont}" Content="&#xE74B;" />
            </StackPanel>
        </DockPanel>

        <!-- Column titles, aligned with the rows below (same column widths) -->
        <Grid DockPanel.Dock="Top" Margin="7,0,11,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource ColumnTitle}" />
            <TextBlock Grid.Column="2" Text="Type" Style="{StaticResource ColumnTitle}" Margin="6,0,0,0"
                       ToolTip="Text for almost everything: Altium reads every field as text. Long text for values over 255 characters (long URLs)." />
            <TextBlock Grid.Column="3" Text="Size" Style="{StaticResource ColumnTitle}" Margin="6,0,0,0"
                       ToolTip="Maximum length of a Text field, 1 to 255 characters" />
            <TextBlock Grid.Column="4" Text="Required" Style="{StaticResource ColumnTitle}" HorizontalAlignment="Center"
                       ToolTip="Access won't save a row with this field empty" />
            <TextBlock Grid.Column="5" Text="Key" Style="{StaticResource ColumnTitle}" HorizontalAlignment="Center"
                       ToolTip="Primary key: unique and required. Put it on Part Number, which Altium finds components by." />
        </Grid>

        <Border BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" CornerRadius="4">
            <ListBox x:Name="List" ItemsSource="{Binding Fields, ElementName=Root}" BorderThickness="0" Background="Transparent"
                     Padding="2" SelectionMode="Single" SelectionChanged="List_SelectionChanged" PreviewKeyDown="List_PreviewKeyDown"
                     PreviewGotKeyboardFocus="List_PreviewGotKeyboardFocus" AllowDrop="True" PreviewDragOver="List_DragOver" PreviewDrop="List_Drop"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Continue">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListItem}">
                        <Setter Property="Padding" Value="4,2,8,2" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <!-- Drag handle -->
                            <Border Background="Transparent" Cursor="SizeAll" ToolTip="Drag to move the field"
                                    PreviewMouseLeftButtonDown="Grip_MouseDown" MouseMove="Grip_MouseMove">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE784;" FontSize="12" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            </Border>
                            <TextBox Grid.Column="1" Style="{StaticResource CellText}"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Grid.Column="2" Style="{StaticResource CellCombo}" Margin="6,0,0,0"
                                      ItemsSource="{x:Static local:FieldsEditor.TypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Type}" />
                            <TextBox x:Name="SizeBox" Grid.Column="3" Style="{StaticResource CellText}" Margin="6,0,0,0"
                                     Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox x:Name="RequiredCheck" Grid.Column="4" Style="{StaticResource CellCheck}" IsChecked="{Binding Required}" />
                            <CheckBox Grid.Column="5" Style="{StaticResource CellCheck}" IsChecked="{Binding PrimaryKey}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <!-- Only Text fields have a size; key fields are always required -->
                            <DataTrigger Binding="{Binding HasSize}" Value="False">
                                <Setter TargetName="SizeBox" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PrimaryKey}" Value="True">
                                <Setter TargetName="RequiredCheck" Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
