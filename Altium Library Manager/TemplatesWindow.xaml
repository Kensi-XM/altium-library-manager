<Window x:Class="Altium_Library_Manager.TemplatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Altium_Library_Manager"
        Title="Table templates" Width="940" Height="660" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <local:DialogTitleBar DockPanel.Dock="Top" Icon="&#xE8A5;" Title="Table templates" />

        <!-- Changes are saved when you switch to another template or close the window -->
        <DockPanel DockPanel.Dock="Bottom" Margin="12,10,12,12">
            <Button DockPanel.Dock="Right" Content="Close" Width="96" IsCancel="True"
                    Style="{DynamicResource AccentButtonStyle}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Import…" Padding="12,4" Click="Import_Click" ToolTip="Add templates from .json files" />
                <Button x:Name="ExportButton" Content="Export…" Padding="12,4" Margin="8,0,0,0" Click="Export_Click"
                        ToolTip="Save the selected template as a .json file, to share it or keep a copy" />
                <Button Content="Open folder" Padding="12,4" Margin="8,0,0,0" Click="OpenFolder_Click"
                        ToolTip="The folder where the templates are kept, one .json file each" />
            </StackPanel>
        </DockPanel>

        <Grid Margin="6,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <local:ClippingBorder Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New template" Click="New_Click" />
                                <Button x:Name="DuplicateButton" Style="{StaticResource IconButton}" Content="&#xE8C8;" Margin="2,0,0,0"
                                        ToolTip="Duplicate the selected template" Click="Duplicate_Click" />
                                <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="2,0,0,0"
                                        ToolTip="Delete the selected template" Click="Delete_Click" />
                            </StackPanel>
                            <TextBlock Text="Templates" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Grid>
                        <ListBox x:Name="TemplateList" BorderThickness="0" Background="Transparent" Padding="4"
                                 ItemContainerStyle="{StaticResource NavListItem}" SelectionChanged="TemplateList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="TemplateList_KeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding FieldCount}" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource SettingHint}" Margin="16" TextAlignment="Center"
                                   Text="No templates yet. Create one with +, import a .json file, or right-click a table in the main window and choose Save as template." />
                    </Grid>
                </DockPanel>
            </local:ClippingBorder>

            <local:ClippingBorder Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel x:Name="EditPanel" Margin="20,16,20,16">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Template" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Name" Style="{StaticResource SettingLabel}" Margin="0,0,0,4" />
                        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Description" Style="{StaticResource SettingLabel}" />
                        <TextBox x:Name="DescriptionBox" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="False" MinHeight="32" MaxHeight="80" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="Fields" Style="{StaticResource SettingLabel}" Margin="0,14,0,8" />
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Style="{StaticResource ErrorText}" Margin="0,8,0,0" />
                    <local:FieldsEditor x:Name="Editor" Changed="Editor_Changed" />
                </DockPanel>
            </local:ClippingBorder>
        </Grid>
    </DockPanel>
</Window>
