<Window x:Class="Altium_Library_Manager.AddElementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Altium_Library_Manager"
        Title="Add elements" Width="1160" Height="800" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <!-- Same look as the other dialogs: own title bar, content in rounded cards (styles in App.xaml) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TypeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <!-- Compact text box of the field list: Fluent's is a tall touch target with a clear button -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="6,0" VerticalAlignment="Center" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="0,0,3,3"
                                    Background="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <local:DialogTitleBar DockPanel.Dock="Top" Icon="&#xE8FD;" Title="Add elements" />

        <DockPanel DockPanel.Dock="Bottom" Margin="12,10,12,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="AddButton" Content="Add rows" MinWidth="120" IsDefault="True" Click="Add_Click"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" Width="96" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </DockPanel>

        <Grid Margin="6,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="240" />
            </Grid.RowDefinitions>

            <!-- Which values -->
            <local:ClippingBorder Grid.RowSpan="3" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Text="Values" FontWeight="SemiBold" Margin="0,2" />
                    </Border>
                    <StackPanel Margin="14,10,14,14">
                        <TextBlock Text="Element" Style="{StaticResource SettingLabel}" Margin="0,0,0,4" />
                        <ComboBox x:Name="KindCombo" SelectionChanged="Kind_SelectionChanged" HorizontalAlignment="Stretch" MaxDropDownHeight="420" />
                        <!-- The types are JSON files: to share, back up or edit by hand -->
                        <WrapPanel Margin="-3,6,0,0">
                            <Button Content="Import…" Style="{StaticResource TypeButton}" Click="Import_Click"
                                    ToolTip="Add element types from JSON files" />
                            <Button Content="Export…" Style="{StaticResource TypeButton}" Click="Export_Click"
                                    ToolTip="Write this element type to a JSON file" />
                            <Button Content="Save as…" Style="{StaticResource TypeButton}" Click="SaveAs_Click"
                                    ToolTip="Keep this as a type of its own: the values and the fields as they are now" />
                            <Button Content="Folder" Style="{StaticResource TypeButton}" Click="Folder_Click"
                                    ToolTip="Open the folder of the type files" />
                        </WrapPanel>

                        <RadioButton x:Name="SeriesRadio" Content="Standard series" Margin="0,14,0,0" GroupName="Source" Checked="Source_Changed" />
                        <Grid x:Name="SeriesPanel" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Series" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox x:Name="SeriesCombo" Grid.Column="1" SelectionChanged="Inputs_Changed" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="1" Text="From" VerticalAlignment="Center" Margin="0,8,10,0" />
                            <TextBox x:Name="FromBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource FieldBox}" TextChanged="Inputs_Changed" />
                            <TextBlock Grid.Row="2" Text="To" VerticalAlignment="Center" Margin="0,8,10,0" />
                            <TextBox x:Name="ToBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource FieldBox}" TextChanged="Inputs_Changed" />
                        </Grid>

                        <RadioButton x:Name="ListRadio" Content="List" Margin="0,14,0,0" GroupName="Source" Checked="Source_Changed" />
                        <!-- Ready lists of the type: picking one fills the list below, to edit as needed -->
                        <ComboBox x:Name="ReadyLists" Margin="0,6,0,0" HorizontalAlignment="Stretch" SelectionChanged="ReadyLists_SelectionChanged"
                                  ToolTip="A ready list of this type's usual values" />
                        <TextBox x:Name="ValuesList" Margin="0,6,0,0" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" TextChanged="Inputs_Changed"
                                 ToolTip="One value per line, or separated by commas: 100, 120, 130, 4K7, 1.5M" />
                        <TextBlock x:Name="ValuesHint" Style="{StaticResource SettingHint}" Margin="0,10,0,0" />
                    </StackPanel>
                </DockPanel>
            </local:ClippingBorder>

            <!-- What each row gets -->
            <local:ClippingBorder Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock x:Name="FieldsTitle" Text="Fields" FontWeight="SemiBold" Margin="0,2" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <TextBlock x:Name="PatternHint" DockPanel.Dock="Top" Style="{StaticResource SettingHint}" Margin="12,8,12,6" />
                    <ListBox x:Name="FieldList" BorderThickness="0" Background="Transparent" Padding="6,0,6,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Continue">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="0,1" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ElementField}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <Button Grid.Column="1" Content="{Binding Glyph}" Click="FieldButton_Click" ToolTip="{Binding Tip}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasButton}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBox Grid.Column="2" Style="{StaticResource FieldBox}" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </local:ClippingBorder>

            <!-- The rows it makes -->
            <local:ClippingBorder Grid.Column="2" Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock x:Name="PreviewTitle" Text="Rows" FontWeight="SemiBold" Margin="0,2" />
                    </Border>
                    <DataGrid x:Name="PreviewGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" BorderThickness="0"
                              Background="Transparent" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource PanelHeaderBrush}"
                              RowHeight="22" CanUserSortColumns="False" SelectionMode="Single" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="2*" />
                            <DataGridTextColumn x:Name="PreviewValueColumn" Header="Value" Binding="{Binding Value}" Width="*" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" />
                            <DataGridTextColumn Header="" Binding="{Binding Note}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </local:ClippingBorder>
        </Grid>
    </DockPanel>
</Window>
