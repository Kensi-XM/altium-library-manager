<Window x:Class="Altium_Library_Manager.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Altium_Library_Manager"
        Title="Altium Library Manager Help" Width="1040" Height="720" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Same look as the other windows. Not a dialog: it stays open beside the main window while you work -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <local:DialogTitleBar DockPanel.Dock="Top" Icon="&#xE897;" Title="Help" />

        <Grid Margin="6,0,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <local:ClippingBorder Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="8,8,8,4">
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                 ToolTip="Finds topics with every word you type. Down goes to the list, Esc clears" />
                        <TextBlock Text="Search help (Ctrl+F)" Foreground="{DynamicResource MutedTextBrush}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock x:Name="NothingFound" DockPanel.Dock="Top" Style="{StaticResource SettingHint}" Margin="14,8,14,0"
                               Text="Nothing found. Try fewer words." Visibility="Collapsed" />
                    <ListBox x:Name="TopicList" SelectionChanged="TopicList_SelectionChanged" BorderThickness="0" Background="Transparent"
                             Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </local:ClippingBorder>

            <local:ClippingBorder Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6,8,0">
                        <Button x:Name="BackButton" Click="Back_Click" Padding="10,3" IsEnabled="False" ToolTip="Back (Alt+Left)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" VerticalAlignment="Center" />
                                <TextBlock Text="Back" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <FlowDocumentScrollViewer x:Name="Page" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Focusable="True" />
                </DockPanel>
            </local:ClippingBorder>
        </Grid>
    </DockPanel>
</Window>
