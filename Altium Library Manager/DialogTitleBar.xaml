<UserControl x:Class="Altium_Library_Manager.DialogTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="36">
    <!-- Title bar of the dialogs: drags the window (WindowChrome caption, CaptionHeight 36); the close button opts out -->
    <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <!-- Optional icon (message boxes show theirs in the content instead) -->
            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="15" Text="{Binding Icon, ElementName=Root}" VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Icon, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource CaptionButton}" Height="36"
                Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button.Resources>
                <SolidColorBrush x:Key="CaptionHoverBrush" Color="#FFC42B1C" />
                <SolidColorBrush x:Key="CaptionPressedBrush" Color="#FFC83C31" />
                <SolidColorBrush x:Key="CaptionHoverForegroundBrush" Color="White" />
            </Button.Resources>
        </Button>
    </Grid>
</UserControl>
